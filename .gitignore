# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.neon

# Brand and design source. The brandbook PDF, the PRD and the design-system
# exports are internal material and were purged from this repository's history
# on 23 Sep 2026. Nothing imports them — every reference in the codebase is a
# provenance comment — so keeping them out costs the build nothing.
# Local copies live outside the repo.
design/
